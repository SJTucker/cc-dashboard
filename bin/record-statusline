#!/usr/bin/env node
'use strict';

// Piped one line of statusLine-shaped JSON on stdin by the mod's session.measure
// hook (mod/hooks/register.ts). The mod reports a non-zero exit as a failure in
// the transcript, so this script must exit 0 whatever stdin contains. It never
// prints anything, because the mod does not use its stdout.
// It records two things: the plan rate limits (lib/limits.js) and a snapshot of
// the session's cost block (lib/sessions.js). Each runs on its own, so a failure
// in one does not stop the other.

const { loadConfig } = require('../lib/config-dir');
const { recordRateLimits, getRateLimitsPath } = require('../lib/limits');
const { recordSession, getSessionsDir } = require('../lib/sessions');

const { configDir } = loadConfig();

let input = '';
process.stdin.on('data', (chunk) => {
  input += chunk;
});
process.stdin.on('error', () => process.exit(0));
process.stdin.on('end', () => {
  let parsed;
  try {
    parsed = JSON.parse(input);
  } catch {
    process.exit(0); // bad JSON: say nothing, exit clean
  }
  try {
    recordRateLimits(parsed, getRateLimitsPath(configDir));
  } catch {
    // An unwritable file or a missing transcript: say nothing.
  }
  recordSession(parsed, getSessionsDir(configDir)); // never throws
  process.exit(0);
});
