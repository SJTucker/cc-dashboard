#!/usr/bin/env node
'use strict';

// Run by the mod's session.end hook (mod/hooks/register.ts), which pipes one JSON
// object on stdin with the ending session's session_id and the reason it ended.
// The mod reports a non-zero exit as a failure in the transcript, so this script
// must exit 0 whatever stdin contains. It never prints anything, because the mod
// does not use its stdout. It marks the session's
// snapshot as ended (lib/sessions.js).

const { loadConfig } = require('../lib/config-dir');
const { recordSessionEnd, getSessionsDir } = require('../lib/sessions');

const { configDir } = loadConfig();

let input = '';
process.stdin.on('data', (chunk) => {
  input += chunk;
});
process.stdin.on('error', () => process.exit(0));
process.stdin.on('end', () => {
  let parsed;
  try {
    parsed = JSON.parse(input);
  } catch {
    process.exit(0); // bad JSON: say nothing, exit clean
  }
  recordSessionEnd(parsed, getSessionsDir(configDir)); // never throws
  process.exit(0);
});
