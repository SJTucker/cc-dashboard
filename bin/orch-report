#!/usr/bin/env node
'use strict';

// Per-task metrics of an orchestrate run, from its event log.
//
//   orch-report <image path> [--json]
//
// Reads <run>/events.jsonl (the run folder is the image path with .md replaced by
// .run), each claimed agent's agent-usage step file and transcript, and the image
// text. Prints a run line, one row per task and one row per agent. Cost, peak
// context and cache share come from the agent's step file. The server deletes that
// file a day after its last write, so without it they come from the usage lines of
// the agent's transcript. They are n/a for an agent with neither. Reads outside the
// image are n/a for an agent with no transcript. --json prints the report as JSON.
//
// A missing image, or a run folder with no events, prints `orch-report: <reason>`
// on stderr and exits 1.

const fs = require('fs');
const { parseArgs } = require('util');
const { loadConfig } = require('../lib/config-dir');
const { runDirOf } = require('../lib/orchestrations/claims');
const { eventsPath, parseEvents } = require('../lib/orchestrations/events');
const { buildReport, renderReport, transcriptSteps } = require('../lib/orchestrations/report');
const { readAgentSteps, getAgentUsageDir } = require('../lib/agent-steps');
const { filesRead } = require('../lib/transcript-index');
const path = require('path');

const USAGE = 'usage: orch-report <image path> [--json]';

function readText(file, what) {
  try {
    return fs.readFileSync(file, 'utf8');
  } catch (err) {
    throw new Error(`cannot read ${what} ${file}: ${err.code ?? err.message}`);
  }
}

async function stepsOf(dir, agent) {
  if (!/^[\w-]+$/.test(agent)) return [];
  const rows = await readAgentSteps(path.join(dir, `${agent}.json`));
  return rows.ok ? rows.agentSteps : [];
}

function transcriptLines(transcript) {
  if (typeof transcript !== 'string') return null;
  try {
    return fs.readFileSync(transcript, 'utf8').split('\n').filter(Boolean);
  } catch {
    return null;
  }
}

async function main() {
  const { values, positionals } = parseArgs({ allowPositionals: true, options: { json: { type: 'boolean' } } });
  if (positionals.length !== 1) throw new Error(USAGE);
  const image = path.resolve(positionals[0]);
  const imageText = readText(image, 'the image');
  const events = parseEvents(readText(eventsPath(runDirOf(image)), 'the event log'));
  const usageDir = getAgentUsageDir(loadConfig().configDir);
  const steps = {};
  const reads = {};
  for (const e of events) {
    if (e.kind !== 'claimed' || typeof e.agent !== 'string' || e.agent in reads) continue;
    const lines = transcriptLines(e.transcript);
    const fromFile = await stepsOf(usageDir, e.agent);
    steps[e.agent] = fromFile.length || !lines ? fromFile : transcriptSteps(lines);
    reads[e.agent] = lines ? filesRead(lines) : null;
  }
  const report = buildReport({ events, steps, reads, imageText, imagePath: image });
  process.stdout.write(values.json ? `${JSON.stringify(report, null, 2)}\n` : renderReport(report));
}

main().catch((err) => {
  process.stderr.write(`orch-report: ${err.message}\n`);
  process.exitCode = 1;
});
