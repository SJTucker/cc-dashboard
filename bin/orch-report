#!/usr/bin/env node
'use strict';

// Per-task metrics of an orchestrate run, from its event log.
//
//   orch-report <image path> [--json]
//
// Reads <run>/events.jsonl (the run folder is the image path with .md replaced by
// .run), each claimed agent's agent-usage step file and transcript, and the image
// text. A final-review event adds the final-review agent and every agent it started,
// found through the parentAgentId in the agent-*.meta.json files beside the claimed
// transcripts. Prints a run line, one row per task and one row per agent. Cost, peak
// context and cache share come from the agent's step file. The server deletes that
// file a day after its last write, so without it they come from the usage lines of
// the agent's transcript. They are n/a for an agent with neither. Reads outside the
// image are n/a for an agent with no transcript. --json prints the report as JSON.
// Also reads the task files under claimed/ and the agent-*.jsonl transcripts of agents
// with no claimed event, in the subagent folders of the run's watched workers, to price
// an agent that claimed a task with no claimed event (a reviewer run without a watch).
//
// Saves the report as <run>/report.json after each run. A field that is n/a in a later
// run takes its value from that file, so costs outlast the step files. A failed save
// prints a line on stderr and keeps exit code 0.
//
// A missing image, or a run folder with no events, prints `orch-report: <reason>`
// on stderr and exits 1.

const fs = require('fs');
const os = require('os');
const { parseArgs } = require('util');
const { loadConfig } = require('../lib/config-dir');
const { runDirOf, writeAtomic, unwatchedClaims } = require('../lib/orchestrations/claims');
const { eventsPath, parseEvents } = require('../lib/orchestrations/events');
const { buildReport, renderReport, mergeSnapshot, transcriptSteps } = require('../lib/orchestrations/report');
const { readAgentSteps, getAgentUsageDir } = require('../lib/agent-steps');
const { filesRead } = require('../lib/transcript-index');
const path = require('path');

const USAGE = 'usage: orch-report <image path> [--json]';

function readText(file, what) {
  try {
    return fs.readFileSync(file, 'utf8');
  } catch (err) {
    throw new Error(`cannot read ${what} ${file}: ${err.code ?? err.message}`);
  }
}

async function stepsOf(dir, agent) {
  if (!/^[\w-]+$/.test(agent)) return [];
  const rows = await readAgentSteps(path.join(dir, `${agent}.json`));
  return rows.ok ? rows.agentSteps : [];
}

// The ids of agents whose parentAgentId chain reaches `root`, from the meta files in `dir`.
function descendantsOf(dir, root) {
  const parent = new Map();
  let names = [];
  try {
    names = fs.readdirSync(dir);
  } catch {
    // no folder, no children
  }
  for (const name of names) {
    const m = /^agent-([\w-]+)\.meta\.json$/.exec(name);
    if (!m) continue;
    try {
      const p = JSON.parse(fs.readFileSync(path.join(dir, name), 'utf8')).parentAgentId;
      if (typeof p === 'string') parent.set(m[1], p);
    } catch {
      // an unreadable meta file names no parent
    }
  }
  const found = new Set();
  let grew = true;
  while (grew) {
    grew = false;
    for (const [id, p] of parent) {
      if (!found.has(id) && (p === root || found.has(p))) {
        found.add(id);
        grew = true;
      }
    }
  }
  return [...found];
}

function transcriptLines(transcript) {
  if (typeof transcript !== 'string') return null;
  try {
    return fs.readFileSync(transcript, 'utf8').split('\n').filter(Boolean);
  } catch {
    return null;
  }
}

// An agent's steps from its step file, else from agent-<id>.jsonl in the first of `subDirs` that holds it.
// `found` is false when the agent has neither.
async function stepsOrTranscript(usageDir, agent, subDirs) {
  const fromFile = await stepsOf(usageDir, agent);
  if (fromFile.length > 0) return { steps: fromFile, found: true };
  if (!/^[\w-]+$/.test(agent)) return { steps: [], found: false };
  for (const dir of subDirs) {
    const lines = transcriptLines(path.join(dir, `agent-${agent}.jsonl`));
    if (lines) return { steps: transcriptSteps(lines), found: true };
  }
  return { steps: [], found: false };
}

async function main() {
  const { values, positionals } = parseArgs({ allowPositionals: true, options: { json: { type: 'boolean' } } });
  if (positionals.length !== 1) throw new Error(USAGE);
  const image = path.resolve(positionals[0]);
  const imageText = readText(image, 'the image');
  const events = parseEvents(readText(eventsPath(runDirOf(image)), 'the event log'));
  const { configDir } = loadConfig();
  const usageDir = getAgentUsageDir(configDir);
  const steps = {};
  const reads = {};
  const loadClaimed = async (list) => {
    for (const e of list) {
      if (e.kind !== 'claimed' || typeof e.agent !== 'string' || e.agent in reads) continue;
      const lines = transcriptLines(e.transcript);
      const fromFile = await stepsOf(usageDir, e.agent);
      steps[e.agent] = fromFile.length || !lines ? fromFile : transcriptSteps(lines);
      reads[e.agent] = lines ? filesRead(lines) : null;
    }
  };
  await loadClaimed(events);
  let finalPartial = false;
  const subDirs = [...new Set(events.filter((e) => e.kind === 'claimed' && typeof e.transcript === 'string').map((e) => path.dirname(e.transcript)))];
  // Agents that ran without a watch have no claimed event. They stay in memory: orch-misses reads events.jsonl.
  const known = new Set(events.filter((e) => e.kind === 'claimed').map((e) => e.file));
  const extra = unwatchedClaims(runDirOf(image), subDirs, known, new Set(events.filter((e) => e.kind === 'claimed' && typeof e.agent === 'string').map((e) => e.agent)));
  // Insert by time: slotWait takes the first work claim in array order. Array.sort is stable.
  events.push(...extra);
  events.sort((a, b) => Date.parse(a.t) - Date.parse(b.t));
  await loadClaimed(extra);
  for (const e of events) {
    if (e.kind !== 'final-review' || typeof e.agent !== 'string' || e.agent in steps) continue;
    const children = [...new Set(subDirs.flatMap((dir) => descendantsOf(dir, e.agent)))];
    const own = await stepsOrTranscript(usageDir, e.agent, subDirs);
    const all = [...own.steps];
    for (const child of children) {
      const rows = await stepsOrTranscript(usageDir, child, subDirs);
      // A child with neither a step file nor a transcript is a gap. It counts as partial only beside the final agent's own steps.
      if (!rows.found && own.steps.length > 0) finalPartial = true;
      all.push(...rows.steps);
    }
    steps[e.agent] = all;
  }
  const runDir = runDirOf(image);
  const saved = path.join(runDir, 'report.json');
  let prev = null;
  try {
    prev = JSON.parse(fs.readFileSync(saved, 'utf8'));
  } catch {
    // no saved report, or an unreadable one, counts as none
  }
  // Working files: the run folder, temp folders (/tmp is /private/tmp on macOS) and Claude Code's transcripts.
  const ignoreDirs = [runDir, '/tmp', '/private/tmp', os.tmpdir(), path.join(configDir, 'projects')];
  try {
    ignoreDirs.push(fs.realpathSync(os.tmpdir()));
  } catch {
    // TMPDIR names a missing folder
  }
  const report = mergeSnapshot(buildReport({ events, steps, reads, imageText, imagePath: image, finalPartial, ignoreDirs }), prev);
  process.stdout.write(values.json ? `${JSON.stringify(report, null, 2)}\n` : renderReport(report));
  try {
    writeAtomic(saved, `${JSON.stringify(report, null, 2)}\n`);
  } catch (err) {
    process.stderr.write(`orch-report: could not save report.json: ${err.code ?? err.message}\n`);
  }
}

main().catch((err) => {
  process.stderr.write(`orch-report: ${err.message}\n`);
  process.exitCode = 1;
});
