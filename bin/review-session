#!/usr/bin/env node
'use strict';

// Run by the dashboard's Claude Code mod (mod/hooks/register.ts), which calls Haiku
// because only the mod can. Two subcommands:
//   prompt   claims ended sessions not reviewed yet and prints
//            {"reviews": [{"sessionId", "system", "prompt"}]}
//   record   {"sessionId", "reply"} or {"sessionId", "error"} on stdin; writes
//            the review to transcripts.db
// Prints one JSON object on success. On failure it prints the reason on stderr
// and exits 1, and the mod logs it.

const { pendingReviews, recordReview } = require('../lib/review');
const { openReviewDb } = require('../lib/review-db');
const { getStorePath } = require('../lib/db');

function readStdin() {
  return new Promise((resolve, reject) => {
    let input = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (chunk) => {
      input += chunk;
    });
    process.stdin.on('end', () => resolve(input));
    process.stdin.on('error', reject);
  });
}

function fail(message) {
  process.stderr.write(`review-session: ${message}\n`);
  process.exitCode = 1;
}

const [command] = process.argv.slice(2);
if (command !== 'prompt' && command !== 'record') {
  fail('usage: review-session prompt | record');
} else {
  let db = null;
  try {
    db = openReviewDb();
  } catch (err) {
    fail(`cannot open ${getStorePath()}: ${String(err.message).split('\n')[0]}`);
  }
  if (db) {
    const work =
      command === 'prompt' ? pendingReviews({ db }).then((reviews) => ({ reviews }))
      : readStdin().then((input) => recordReview(db, JSON.parse(input)));
    work.then(
      (out) => process.stdout.write(JSON.stringify(out) + '\n'),
      (err) => fail(err.message),
    ).finally(() => db.close());
  }
}
