#!/usr/bin/env node
'use strict';

// Run by the dashboard's Claude Code mod (mod/hooks/register.ts), which calls Haiku
// because only the mod can. Two subcommands:
//   prompt   closes open suggestions older than 14 days, claims ended sessions not reviewed yet and prints
//            {"reviews": [{"sessionId", "system", "prompt"}]}. While settings.json
//            has "reviews": false it claims nothing and prints {"reviews": []}.
//   record [--input <file>]
//            {"sessionId", "reply"} or {"sessionId", "error"} on stdin, or in
//            <file>, which is deleted after it is read; writes the review to
//            transcripts.db
// Prints one JSON object on success. On failure it prints the reason on stderr
// and exits 1, and the mod logs it.

const { pendingReviews, recordReview, expireSuggestions } = require('../lib/review');
const { loadConfig } = require('../lib/config-dir');
const { getProjectsDir } = require('../lib/transcript-files');
const { getSessionsDir } = require('../lib/sessions');
const { openReviewDb, legacyReviewsDir } = require('../lib/review-db');
const { getStorePath } = require('../lib/db');
const { readSettings } = require('../lib/settings');
const { readInput } = require('../lib/stdin');

function fail(message) {
  process.stderr.write(`review-session: ${message}\n`);
  process.exitCode = 1;
}

const { configDir } = loadConfig();
const storePath = getStorePath(configDir);

const [command] = process.argv.slice(2);
if (command !== 'prompt' && command !== 'record') {
  fail('usage: review-session prompt | record');
} else {
  let db = null;
  try {
    db = openReviewDb(storePath, legacyReviewsDir(configDir));
  } catch (err) {
    fail(`cannot open ${storePath}: ${String(err.message).split('\n')[0]}`);
  }
  if (db) {
    const work =
      command === 'prompt'
        ? Promise.resolve()
          .then(() => expireSuggestions(db))
          .then(() => (readSettings(configDir).reviews
            ? pendingReviews({ db, sessionsDir: getSessionsDir(configDir), projects: getProjectsDir(configDir), configDir })
            : []))
          .then((reviews) => ({ reviews }))
        : readInput(process.argv.slice(3)).then((input) => recordReview(db, JSON.parse(input)));
    work.then(
      (out) => process.stdout.write(JSON.stringify(out) + '\n'),
      (err) => fail(err.message),
    ).finally(() => db.close());
  }
}
