#!/bin/sh
# Takes a fresh clone to installed dependencies, a linked, validated mod and a linked
# orchestrate skill. It runs the steps in SETUP.md, so a change to those steps changes this script too.
# Preflight changes nothing on disk, so a failed check leaves nothing half done.
# It does not start the server or edit settings.json.

set -u
unset CDPATH

clone=$(cd "$(dirname "$0")/.." && pwd -P)
mod="$clone/mod"
skill="$clone/skills/orchestrate"

# <cfg> as lib/config-dir.js resolves it: a leading ~ is expanded, empty is unset.
case "${CLAUDE_CONFIG_DIR:-}" in
  '') cfg="$HOME/.claude" ;;
  '~'*) cfg="$HOME${CLAUDE_CONFIG_DIR#\~}" ;;
  *) cfg="$CLAUDE_CONFIG_DIR" ;;
esac
link="$cfg/skills/cc-dashboard"
skill_link="$cfg/skills/orchestrate"

# Each step line prints as it happens and is also kept for the summary at the end.
results=
record() {
  printf '%s\n' "$1"
  results="$results$1
"
}
ok() { record "$(printf 'ok    %s' "$1")"; }
warn() { record "$(printf 'warn  %s' "$1")"; }
fail() { record "$(printf 'FAIL  %s' "$1")"; }
summary() { printf '\nSummary:\n%s' "$results"; }
stop() { fail "$1"; summary; exit 1; }

# Preflight

system=$(uname -s)
if [ "$system" = Darwin ]; then
  ok "macOS"
else
  warn "$system: only macOS is tested"
fi

command -v node >/dev/null 2>&1 || stop "node is not on PATH. Install Node 22.13 or later."
version=$(node -p process.versions.node) || stop "node -p process.versions.node failed"
major=${version%%.*}
rest=${version#*.}
minor=${rest%%.*}
case "$major.$minor" in
  *[!0-9.]* | .* | *.) stop "could not read the node version from '$version'" ;;
esac
if [ "$major" -gt 22 ] || { [ "$major" -eq 22 ] && [ "$minor" -ge 13 ]; }; then
  ok "node $version"
else
  stop "node $version is older than 22.13. Install Node 22.13 or later."
fi

command -v npm >/dev/null 2>&1 || stop "npm is not on PATH"
ok "npm"
command -v claude >/dev/null 2>&1 || stop "claude is not on PATH. The mod needs Claude Code. bin/setup cannot use a shell alias, so the folder holding claude must be on PATH."
ok "claude"

# Sets exists to yes or no for the link at $1 that should point at $2. Stops when
# the path holds a link to somewhere else, a dangling link, a folder or a file.
check_link() {
  if [ -L "$1" ]; then
    target=$(readlink "$1")
    # cd from the link's folder so a relative target resolves the way the link does.
    resolved=$(cd "$(dirname "$1")" 2>/dev/null && cd "$target" 2>/dev/null && pwd -P)
    if [ "$resolved" = "$2" ]; then
      exists=yes
    else
      stop "$1 points at $target, not $2. Remove the link and run bin/setup again."
    fi
  elif [ -d "$1" ]; then
    stop "$1 is a folder. Move it aside and run bin/setup again."
  elif [ -e "$1" ]; then
    stop "$1 is a file. Move it aside and run bin/setup again."
  else
    exists=no
  fi
  ok "link path $1"
}

# Creates the link at $1 to $2 unless check_link found it ($3 is yes).
make_link() {
  if [ "$3" = yes ]; then
    ok "$1 already points at $2"
  else
    mkdir -p "$cfg/skills" || stop "could not create $cfg/skills"
    ln -s "$2" "$1" || stop "could not create $1"
    ok "linked $1 -> $2"
  fi
}

check_link "$link" "$mod"
link_exists=$exists
check_link "$skill_link" "$skill"
skill_link_exists=$exists

# Steps

(cd "$clone" && npm install) || stop "npm install failed"
ok "npm install"

make_link "$link" "$mod" "$link_exists"
make_link "$skill_link" "$skill" "$skill_link_exists"

status=0
if claude plugin validate "$mod"; then
  ok "claude plugin validate"
else
  fail "claude plugin validate"
  status=1
fi

summary

if [ "$status" -ne 0 ]; then
  printf '\nFix what claude plugin validate printed above, then run bin/setup again.\n'
  exit "$status"
fi

cat <<EOF

Next: run 'npm start' in $clone, then open http://localhost:3600.
SETUP.md's "Check it works" section lists the checks that need the server or a
Claude Code session.
The mod runs the bin/ scripts through node, so node must be on the PATH Claude
Code sees. This script checked its own PATH only: $(node -p process.execPath)
To check the PATH Claude Code sees, run '!node -v' in a Claude Code session.
EOF

exit 0
