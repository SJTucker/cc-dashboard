#!/usr/bin/env node
'use strict';

// Writes or prints the Markdown index of one transcript, built by
// lib/transcript-index.js.
//
// Run by the mod (mod/hooks/register.ts) one second after each main-thread turn
// of an interactive session, with {"transcript": "<path>", "out": "<path>"} on
// stdin. It writes the index to `out` through a temp file in the same folder and a
// rename, so a reader never sees half a file, and prints nothing. A missing
// transcript writes nothing and exits 0. Stdin that is not JSON with both paths
// prints the reason on stderr and exits 1, and the mod logs it.
//
// Run by hand as `bin/transcript-index <transcript.jsonl>`, it prints the index to
// stdout. A missing file prints the reason on stderr and exits 1.
//
// With `--steps <n>`, run by the orchestrate skill on a worker's transcript, it
// prints a header from the agent-<id>.meta.json beside the file, the files the
// worker read, and its last n steps. A missing file prints "no transcript yet" and
// exits 0, because a worker launched a moment ago has no file yet.

const fs = require('fs');
const path = require('path');
const { parseArgs } = require('util');
const { buildIndex, renderIndex, recentSteps, contextTokens } = require('../lib/transcript-index');
const { readStdin } = require('../lib/stdin');

function fail(message) {
  process.stderr.write(`transcript-index: ${message}\n`);
  process.exitCode = 1;
}

// The file's lines, without the empty string a final newline leaves. Null when
// the file cannot be read.
function readLines(file) {
  let text;
  try {
    text = fs.readFileSync(file, 'utf8');
  } catch {
    return null;
  }
  const lines = text.split('\n');
  if (lines.at(-1) === '') lines.pop();
  return lines;
}

function pathsOf(input) {
  try {
    const parsed = JSON.parse(input);
    if (typeof parsed?.transcript !== 'string' || typeof parsed?.out !== 'string') return null;
    return { transcript: parsed.transcript, out: parsed.out };
  } catch {
    return null;
  }
}

function writeIndex({ transcript, out }) {
  const lines = readLines(transcript);
  if (lines === null) return;
  const dir = path.dirname(out);
  const md = renderIndex(buildIndex(lines), transcript, dir);
  fs.mkdirSync(dir, { recursive: true });
  const tmp = path.join(dir, `.${path.basename(out)}.${process.pid}.tmp`);
  // A failed write (a full disk) must not leave a temp file behind each turn.
  try {
    fs.writeFileSync(tmp, md);
    fs.renameSync(tmp, out);
  } catch (err) {
    fs.rmSync(tmp, { force: true });
    throw err;
  }
}

const USAGE = `usage: transcript-index                              read {"transcript","out"} on stdin, write the index to out
       transcript-index <transcript.jsonl>          print the index
       transcript-index <transcript.jsonl> --steps <n>
                                                    print a worker's header, files read and last n steps
`;

// The agent-<id>.meta.json beside a worker transcript, or null.
function readMeta(file) {
  try {
    const meta = JSON.parse(fs.readFileSync(file.replace(/\.jsonl$/, '.meta.json'), 'utf8'));
    return meta && typeof meta === 'object' ? meta : null;
  } catch {
    return null;
  }
}

function stepsHeader(file, lines, index) {
  const tail = `context ${contextTokens(lines) ?? '?'} tokens · ${lines.length} lines · last activity ${index.facts.updatedAt ?? '?'}`;
  const meta = readMeta(file);
  if (!meta) return `${path.basename(file)} · ${tail}`;
  const id = path.basename(file, '.jsonl').replace(/^agent-/, '');
  const kind = `${meta.agentType ?? '?'}, ${meta.model ?? 'default model'}`;
  return `Agent ${id}: "${meta.description ?? ''}" (${kind}) · finished: ${meta.finished === true ? 'yes' : 'no'} · ${tail}`;
}

function printSteps(file, n) {
  const lines = readLines(file);
  if (lines === null) {
    process.stdout.write(`no transcript yet: ${file}\n`);
    return;
  }
  const index = buildIndex(lines);
  const read = [...new Set(index.turns.flatMap((t) => t.read))];
  const head = [stepsHeader(file, lines, index), `Read: ${read.length ? read.join(', ') : 'none'}`];
  process.stdout.write([...head, '', ...recentSteps(lines, n)].join('\n') + '\n');
}

function main() {
  let args;
  try {
    args = parseArgs({ allowPositionals: true, options: { steps: { type: 'string' }, help: { type: 'boolean' } } });
  } catch (err) {
    return fail(err.message);
  }
  const { values, positionals } = args;
  if (values.help) return process.stdout.write(USAGE);
  const [file] = positionals;
  if (positionals.length > 1) return fail(`expected one transcript path, got ${positionals.length}`);
  if (values.steps !== undefined) {
    const n = Number(values.steps);
    if (!Number.isInteger(n) || n < 1) return fail(`--steps needs a positive whole number, got ${values.steps}`);
    if (file === undefined) return fail('--steps needs a transcript path');
    return printSteps(file, n);
  }
  if (file !== undefined) {
    const lines = readLines(file);
    if (lines === null) return fail(`cannot read ${file}`);
    return process.stdout.write(renderIndex(buildIndex(lines), path.resolve(file)));
  }
  readStdin()
    .then((input) => {
      const paths = pathsOf(input);
      if (paths === null) return fail('stdin is not JSON with transcript and out paths');
      writeIndex(paths);
    })
    .catch((err) => fail(err.message));
}

main();
