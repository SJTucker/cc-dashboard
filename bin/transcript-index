#!/usr/bin/env node
'use strict';

// Writes or prints the Markdown index of one transcript, built by
// lib/transcript-index.js.
//
// Run by the mod (mod/hooks/register.ts) one second after each main-thread turn
// of an interactive session, with {"transcript": "<path>", "out": "<path>"} on
// stdin. It writes the index to `out` through a temp file in the same folder and a
// rename, so a reader never sees half a file, and prints nothing. A missing
// transcript writes nothing and exits 0. Stdin that is not JSON with both paths
// prints the reason on stderr and exits 1, and the mod logs it.
//
// Run by hand as `bin/transcript-index <transcript.jsonl>`, it prints the index to
// stdout. A missing file prints the reason on stderr and exits 1.
//
// With `--steps <n>`, run by the orchestrate skill on a worker's transcript, it
// prints a header from the agent-<id>.meta.json beside the file, the files the
// worker read, and its last n steps, each cut to one short line; `--full` prints
// each step whole, still on one line. A missing file prints "no transcript yet" and
// exits 0, because a worker launched a moment ago has no file yet.
//
// With `--watch`, run by the orchestrate skill through the Monitor tool, it polls
// the worker's transcript every 2 seconds and prints one line per event (DRIFT,
// STUCK, BUDGET, QUIET, DONE, KILLED, FAILED; see watchEvents), then exits 0 after
// DONE, KILLED or FAILED. It does not print the MSG events watchEvents returns, because
// they tell the orchestrator nothing to act on. It
// waits for a missing file to appear, and leaves a last line that has no newline
// yet for the next poll. `--since-line <n>` skips events up to line n, for a
// watch re-armed after the Monitor tool's time limit. With `--board <path>` it also prints a POST line for each
// post bin/board-post adds to that file after the watch starts.

const fs = require('fs');
const path = require('path');
const { parseArgs } = require('util');
const { buildIndex, renderIndex, recentSteps, contextTokens, watchEvents, boardEvents, filesRead } = require('../lib/transcript-index');

const POLL_MS = 2000;
const { readStdin } = require('../lib/stdin');

function fail(message) {
  process.stderr.write(`transcript-index: ${message}\n`);
  process.exitCode = 1;
}

// The file's lines, without the empty string a final newline leaves. Null when
// the file cannot be read.
function readLines(file) {
  let text;
  try {
    text = fs.readFileSync(file, 'utf8');
  } catch {
    return null;
  }
  const lines = text.split('\n');
  if (lines.at(-1) === '') lines.pop();
  return lines;
}

function pathsOf(input) {
  try {
    const parsed = JSON.parse(input);
    if (typeof parsed?.transcript !== 'string' || typeof parsed?.out !== 'string') return null;
    return { transcript: parsed.transcript, out: parsed.out };
  } catch {
    return null;
  }
}

function writeIndex({ transcript, out }) {
  const lines = readLines(transcript);
  if (lines === null) return;
  const dir = path.dirname(out);
  const md = renderIndex(buildIndex(lines), transcript, dir);
  fs.mkdirSync(dir, { recursive: true });
  const tmp = path.join(dir, `.${path.basename(out)}.${process.pid}.tmp`);
  // A failed write (a full disk) must not leave a temp file behind each turn.
  try {
    fs.writeFileSync(tmp, md);
    fs.renameSync(tmp, out);
  } catch (err) {
    fs.rmSync(tmp, { force: true });
    throw err;
  }
}

const USAGE = `usage: transcript-index                              read {"transcript","out"} on stdin, write the index to out
       transcript-index <transcript.jsonl>          print the index
       transcript-index <transcript.jsonl> --steps <n> [--full]
                                                    print a worker's header, files read and last n steps
       transcript-index <transcript.jsonl> --watch [--files a,b] [--budget N] [--quiet-min M] [--board P] [--since-line N]
                                                    print one line per worker event until it finishes
`;

// The agent-<id>.meta.json beside a worker transcript, or null.
function readMeta(file) {
  try {
    const meta = JSON.parse(fs.readFileSync(file.replace(/\.jsonl$/, '.meta.json'), 'utf8'));
    return meta && typeof meta === 'object' ? meta : null;
  } catch {
    return null;
  }
}

function stepsHeader(file, lines, index) {
  const tail = `context ${contextTokens(lines) ?? '?'} tokens · ${lines.length} lines · last activity ${index.facts.updatedAt ?? '?'}`;
  const meta = readMeta(file);
  if (!meta) return `${path.basename(file)} · ${tail}`;
  const id = path.basename(file, '.jsonl').replace(/^agent-/, '');
  const kind = `${meta.agentType ?? '?'}, ${meta.model ?? 'default model'}`;
  return `Agent ${id}: "${meta.description ?? ''}" (${kind}) · finished: ${meta.finished === true ? 'yes' : 'no'} · ${tail}`;
}

function printSteps(file, n, full) {
  const lines = completeLines(file);
  if (lines === null) {
    process.stdout.write(`no transcript yet: ${file}\n`);
    return;
  }
  const index = buildIndex(lines);
  const read = filesRead(lines);
  const head = [stepsHeader(file, lines, index), `Read: ${read.length ? read.join(', ') : 'none'}`];
  process.stdout.write([...head, '', ...recentSteps(lines, n, { full })].join('\n') + '\n');
}

// The file's complete lines: a last line with no newline is still being written.
// Null when the file cannot be read.
function completeLines(file) {
  let text;
  try {
    text = fs.readFileSync(file, 'utf8');
  } catch {
    return null;
  }
  const lines = text.split('\n');
  lines.pop();
  return lines;
}

function wholeNumber(name, value) {
  const n = Number(value);
  if (!Number.isInteger(n) || n < 0) throw new Error(`--${name} needs a whole number, got ${value}`);
  return n;
}

function positive(name, value) {
  const n = Number(value);
  if (!Number.isFinite(n) || n <= 0) throw new Error(`--${name} needs a positive number, got ${value}`);
  return n;
}

function readText(file) {
  try {
    return fs.readFileSync(file, 'utf8');
  } catch {
    return '';
  }
}

async function watch(file, opts) {
  const quietMs = opts.quietMin * 60_000;
  // Posts from before the watch started are not news.
  let boardSeen = opts.board === null ? 0 : boardEvents(readText(opts.board), 0).seenLines;
  let seen = null;
  let lineCount = -1;
  let grewAt = Date.now();
  let quietSent = false;
  for (;;) {
    if (opts.board !== null) {
      const b = boardEvents(readText(opts.board), boardSeen);
      boardSeen = b.seenLines;
      for (const e of b.events) process.stdout.write(e + '\n');
    }
    const lines = completeLines(file);
    if (lines !== null) {
      if (lines.length !== lineCount) {
        lineCount = lines.length;
        grewAt = Date.now();
        quietSent = false;
      }
      const r = watchEvents(lines, seen, { files: opts.files, budget: opts.budget, sinceLine: opts.sinceLine, finished: readMeta(file)?.finished === true });
      seen = r.seen;
      for (const e of r.events) if (!e.startsWith('MSG ')) process.stdout.write(e + '\n');
      if (r.done) return;
    }
    if (!quietSent && Date.now() - grewAt >= quietMs) {
      quietSent = true;
      process.stdout.write(`QUIET no new lines for ${opts.quietMin} min\n`);
    }
    await new Promise((resolve) => setTimeout(resolve, POLL_MS));
  }
}

function watchOptions(values) {
  return {
    files: values.files === undefined ? null : values.files.split(',').map((x) => x.trim()).filter(Boolean),
    budget: values.budget === undefined ? null : positive('budget', values.budget),
    quietMin: values['quiet-min'] === undefined ? 5 : positive('quiet-min', values['quiet-min']),
    board: values.board ?? null,
    sinceLine: values['since-line'] === undefined ? 0 : wholeNumber('since-line', values['since-line']),
  };
}

const OPTIONS = {
  steps: { type: 'string' },
  full: { type: 'boolean' },
  watch: { type: 'boolean' },
  files: { type: 'string' },
  budget: { type: 'string' },
  'quiet-min': { type: 'string' },
  board: { type: 'string' },
  'since-line': { type: 'string' },
  help: { type: 'boolean' },
};

function main() {
  let args;
  try {
    args = parseArgs({ allowPositionals: true, options: OPTIONS });
  } catch (err) {
    return fail(err.message);
  }
  const { values, positionals } = args;
  if (values.help) return process.stdout.write(USAGE);
  const [file] = positionals;
  if (positionals.length > 1) return fail(`expected one transcript path, got ${positionals.length}`);
  if (values.full && values.steps === undefined) return fail('--full works only with --steps');
  if (values.steps !== undefined && values.watch) return fail('--steps and --watch cannot be used together');
  if (values.steps !== undefined) {
    const n = Number(values.steps);
    if (!Number.isInteger(n) || n < 1) return fail(`--steps needs a positive whole number, got ${values.steps}`);
    if (file === undefined) return fail('--steps needs a transcript path');
    return printSteps(file, n, values.full === true);
  }
  if (values.watch) {
    if (file === undefined) return fail('--watch needs a transcript path');
    let opts;
    try {
      opts = watchOptions(values);
    } catch (err) {
      return fail(err.message);
    }
    return watch(file, opts).catch((err) => fail(err.message));
  }
  if (file !== undefined) {
    const lines = readLines(file);
    if (lines === null) return fail(`cannot read ${file}`);
    return process.stdout.write(renderIndex(buildIndex(lines), path.resolve(file)));
  }
  readStdin()
    .then((input) => {
      const paths = pathsOf(input);
      if (paths === null) return fail('stdin is not JSON with transcript and out paths');
      writeIndex(paths);
    })
    .catch((err) => fail(err.message));
}

main();
